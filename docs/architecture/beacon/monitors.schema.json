{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jirathip-dev/beacon/docs/architecture/beacon/monitors.schema.json",
  "title": "monitors.json v1 (any HTTPS URL, a local file, or the app's local copy)",
  "$comment": "additionalProperties: false is enforced by the CLI (deny_unknown_fields, beacon check); the app ignores unknown fields (ADR D1) and rejects only an unknown version or monitor type.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "monitors"],
  "properties": {
    "version": { "const": 1 },
    "monitors": {
      "description": "Display order is array order.",
      "type": "array",
      "items": { "$ref": "#/$defs/monitor" }
    },
    "hosts": {
      "description": "Hosts running `beacon serve`, keyed by host name (gethostname() or --host).",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/host" }
    },
    "notify": {
      "description": "How `beacon serve --notify` reminds that a check, host or rule is still down (ADR D11). Holds no secret; the webhook and its secret stay in the notify file.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remind_every_h": { "type": "integer", "minimum": 1, "maximum": 168, "default": 4, "description": "Hours between `still down` reminders." },
        "remind_max": { "type": "integer", "minimum": 0, "maximum": 100, "default": 3, "description": "Reminders per outage; 0 sends none." }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "group": { "type": "string", "minLength": 1, "maxLength": 40 },
    "probeTimeout": { "type": "integer", "minimum": 1, "maximum": 30, "description": "Seconds." },
    "monitor": {
      "oneOf": [{ "$ref": "#/$defs/http" }, { "$ref": "#/$defs/tcp" }, { "$ref": "#/$defs/heartbeat" }]
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "group", "url"],
      "properties": {
        "type": { "const": "http" },
        "name": { "$ref": "#/$defs/name" },
        "group": { "$ref": "#/$defs/group" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "expect_status": { "type": "integer", "minimum": 100, "maximum": 599, "description": "Absent: any 2xx." },
        "keyword": { "type": "string", "minLength": 1, "description": "Must appear in the body." },
        "timeout_s": { "$ref": "#/$defs/probeTimeout", "default": 10 }
      }
    },
    "tcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "group", "host", "port"],
      "properties": {
        "type": { "const": "tcp" },
        "name": { "$ref": "#/$defs/name" },
        "group": { "$ref": "#/$defs/group" },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "timeout_s": { "$ref": "#/$defs/probeTimeout", "default": 10 }
      }
    },
    "heartbeat": {
      "description": "One host check's latest result, read from that host's `beacon serve`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "group", "host", "id"],
      "properties": {
        "type": { "const": "heartbeat" },
        "name": { "$ref": "#/$defs/name" },
        "group": { "$ref": "#/$defs/group" },
        "host": { "$ref": "#/$defs/id", "description": "A key of `hosts`." },
        "id": { "$ref": "#/$defs/id", "description": "A check id in hosts.<host>.checks." }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "checks"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "description": "Full status URL the app GETs, e.g. https://macmini.tail1234.ts.net/status. The app GETs the host's metrics at the same URL with its last path segment replaced by `metrics` (ADR D10)." },
        "timeout_s": { "$ref": "#/$defs/probeTimeout", "default": 5 },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/hostCheck" } },
        "disks": {
          "description": "Mount points whose used and free bytes `beacon serve` samples for /metrics (ADR D10). Only serve reads this. An empty list samples no disk.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "default": ["/"],
          "items": { "type": "string", "pattern": "^/", "maxLength": 255, "description": "An absolute path with no control character." }
        },
        "rules": {
          "description": "Metric rules serve judges on each 60 s sample; each acts like a check in /status (ADR D11). Absent: disk-full (disk > 90 for 10 min), memory-full (memory > 90 for 10 min), load-high (load > 2 per core for 15 min). [] turns them off.",
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "jobs": {
          "description": "The review of this host's launchd or systemd user jobs, by label (ADR D12). A label with no entry is unreviewed. Only the CLI reads this; the app ignores it (ADR D1). `beacon jobs keep|ignore|removed` writes it.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/label" },
          "additionalProperties": { "$ref": "#/$defs/review" }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "above", "for_min"],
      "properties": {
        "id": { "$ref": "#/$defs/id", "description": "Unique within its host's rules. A disk rule keeps one status per mount in `disks`: `<id>` for `/`, else `<id>-<mount as a slug>` (/Volumes/T7: `<id>-volumes-t7`). No status id may repeat a check id." },
        "metric": { "enum": ["disk", "memory", "load"], "description": "disk and memory: % used; load: load1 per core." },
        "above": { "type": "number", "minimum": 0, "maximum": 1000, "description": "Down once the metric stays above this for for_min; at most 100 for disk and memory." },
        "for_min": { "type": "integer", "minimum": 1, "maximum": 1440, "description": "Minutes the metric must stay above (down) or at or below (up) before the rule changes." }
      }
    },
    "label": {
      "description": "A launchd label or a systemd unit name: no whitespace and no control character.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    },
    "review": {
      "oneOf": [
        { "const": "ignore", "description": "Not shown and never alerts." },
        { "const": "removed", "description": "Its removal is intended: not shown while it is gone. If it comes back it is unreviewed." },
        {
          "description": "Shown under this name and group; down when it is gone.",
          "type": "object",
          "additionalProperties": false,
          "required": ["keep"],
          "properties": {
            "keep": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "group"],
              "properties": {
                "name": { "$ref": "#/$defs/name" },
                "group": { "$ref": "#/$defs/group" },
                "running": { "type": "boolean", "default": false, "description": "Down whenever it is not running, whatever its kind." }
              }
            }
          }
        }
      ]
    },
    "hostCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command"],
      "properties": {
        "id": { "$ref": "#/$defs/id", "not": { "pattern": "^job-" }, "description": "Unique within its host. `job-` is reserved for discovered jobs (ADR D12)." },
        "command": { "type": "string", "minLength": 1, "description": "Run with `sh -c`; exit 0 = up." },
        "every_s": { "type": "integer", "minimum": 10, "maximum": 86400, "default": 60 },
        "timeout_s": { "type": "integer", "minimum": 1, "maximum": 300, "default": 30, "description": "Killed and down past this." }
      }
    }
  }
}
