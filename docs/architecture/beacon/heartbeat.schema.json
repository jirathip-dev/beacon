{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jirathip-dev/beacon/docs/architecture/beacon/heartbeat.schema.json",
  "title": "beats/<id>.json (beacon-config, orphan branch heartbeats)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "message", "host", "time"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "status": { "enum": ["up", "down"] },
    "message": { "type": "string", "maxLength": 200 },
    "host": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "format": "date-time", "description": "ISO-8601, UTC, seconds precision: 2026-11-12T10:15:00Z" }
  }
}
