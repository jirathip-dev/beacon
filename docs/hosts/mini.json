{
  "version": 1,
  "monitors": [
    {
      "type": "heartbeat",
      "name": "drover doctor",
      "group": "Mini",
      "host": "jirathips-mac-mini",
      "id": "doctor"
    },
    {
      "type": "heartbeat",
      "name": "CLIs on PATH",
      "group": "Mini",
      "host": "jirathips-mac-mini",
      "id": "clis"
    },
    {
      "type": "heartbeat",
      "name": "Disk /",
      "group": "Mini",
      "host": "jirathips-mac-mini",
      "id": "disk"
    }
  ],
  "hosts": {
    "jirathips-mac-mini": {
      "url": "https://jirathips-mac-mini.tail8c3301.ts.net/status",
      "timeout_s": 5,
      "checks": [
        {
          "id": "doctor",
          "command": "command -v drover >/dev/null || { echo 'drover not on PATH'; exit 1; }; x=$(drover doctor 2>&1 | grep -m1 '✗'); test -z \"$x\" && echo 'no ✗' || { echo \"$x\"; exit 1; }",
          "every_s": 900,
          "timeout_s": 290
        },
        {
          "id": "clis",
          "command": "m=; for c in drover shed claude gh git; do command -v \"$c\" >/dev/null || m=\"$m $c\"; done; test -z \"$m\" && echo 'drover shed claude gh git on PATH' || { echo \"missing:$m\"; exit 1; }",
          "every_s": 300,
          "timeout_s": 10
        },
        {
          "id": "disk",
          "command": "df -P / | awk 'NR==2 { gsub(\"%\",\"\",$5); print $5 \"% used\"; exit ($5 < 90 ? 0 : 1) }'",
          "every_s": 300,
          "timeout_s": 10
        }
      ],
      "jobs": {
        "actions.runner.jirathip-dev-cooee.mini-cooee": {"keep":{"name":"actions.runner.jirathip-dev-cooee.mini-cooee","group":"Mini","running":true}},
        "actions.runner.jirathip-dev-shed.shed-mini": {"keep":{"name":"actions.runner.jirathip-dev-shed.shed-mini","group":"Mini","running":true}},
        "dev.cooee.cooee": {"keep":{"name":"dev.cooee.cooee","group":"Mini"}},
        "dev.drover.clean": {"keep":{"name":"dev.drover.clean","group":"Mini"}},
        "dev.drover.fast": {"keep":{"name":"dev.drover.fast","group":"Mini"}},
        "dev.drover.serve": {"keep":{"name":"dev.drover.serve","group":"Mini"}},
        "dev.drover.tick": {"keep":{"name":"dev.drover.tick","group":"Mini"}},
        "dev.drover.update": {"keep":{"name":"dev.drover.update","group":"Mini"}},
        "dev.shed.serve": {"keep":{"name":"dev.shed.serve","group":"Mini"}}
      }
    }
  }
}
