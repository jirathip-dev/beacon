gui/501/com.jirathip.ttyd = {
	active count = 1
	path = /Users/owner/Library/LaunchAgents/com.jirathip.ttyd.plist
	type = LaunchAgent
	state = running

	program = /bin/sh
	arguments = {
		/bin/sh
		-c
		exec run-com.jirathip.ttyd
	}

	inherited environment = {
		SSH_AUTH_SOCK => /private/tmp/com.apple.launchd.x/Listeners
	}

	domain = gui/501 [100005]
	asid = 100005
	minimum runtime = 10
	exit timeout = 5
	runs = 2
	last exit code = 0

	spawn type = daemon (3)
	jetsam priority = 40
	jetsam memory limit (active) = (unlimited)
	jetsamproperties category = daemon
	submitted job. ignore execute allowed
	properties = keepalive | runatload | inferred program | managed LWCR | has LWCR
}
