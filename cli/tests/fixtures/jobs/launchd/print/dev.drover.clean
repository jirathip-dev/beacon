gui/501/dev.drover.clean = {
	active count = 1
	path = /Users/owner/Library/LaunchAgents/dev.drover.clean.plist
	type = LaunchAgent
	state = not running

	program = /bin/sh
	arguments = {
		/bin/sh
		-c
		exec run-dev.drover.clean
	}

	inherited environment = {
		SSH_AUTH_SOCK => /private/tmp/com.apple.launchd.x/Listeners
	}

	domain = gui/501 [100005]
	asid = 100005
	minimum runtime = 10
	exit timeout = 5
	runs = 4
	last exit code = 0

	event triggers = {
		dev.drover.clean.268435473 => {
			keepalive = 0
			service = dev.drover.clean
			stream = com.apple.launchd.calendarinterval
			monitor = com.apple.UserEventAgent-Aqua
			descriptor = {
				"Minute" => 30
				"Hour" => 3
			}
		}
	}
	spawn type = daemon (3)
	jetsam priority = 40
	jetsam memory limit (active) = (unlimited)
	jetsamproperties category = daemon
	submitted job. ignore execute allowed
	properties = runatload | abandon process group | inferred program
}
